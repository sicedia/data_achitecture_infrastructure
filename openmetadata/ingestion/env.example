# OpenMetadata Ingestion Environment Configuration
# Copia este archivo a .env y ajusta los valores según tu entorno

# OpenMetadata Configuration
OPENMETADATA_SERVER_URL=http://localhost:8585
OPENMETADATA_API_ENDPOINT=http://localhost:8585/api
OPENMETADATA_AUTH_PROVIDER=no-auth

# Trino Configuration
TRINO_HOST=localhost
TRINO_PORT=8083
TRINO_USER=dbt
TRINO_CATALOG=iceberg_dev
TRINO_SCHEMA=cedia_bronze_sia

# Airbyte Configuration
AIRBYTE_HOST=localhost
AIRBYTE_PORT=8000
AIRBYTE_USERNAME=airbyte
AIRBYTE_PASSWORD=password

# dbt Configuration
DBT_PROJECT_DIR=/opt/airflow/dbt
DBT_TARGET_DIR=/opt/airflow/dbt/target
DBT_MANIFEST_FILE=/opt/airflow/dbt/target/manifest.json
DBT_CATALOG_FILE=/opt/airflow/dbt/target/catalog.json
DBT_RUN_RESULTS_FILE=/opt/airflow/dbt/target/run_results.json

# MinIO Configuration
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=AKIAIOSFODNN7EXAMPLE
MINIO_SECRET_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
MINIO_BUCKET=cedia-datalake-dev

# Nessie Configuration
NESSIE_URI=http://nessie:19120/api/v2
NESSIE_REF=main

# Workflow Configuration
WORKFLOW_SCHEDULE_INTERVAL=0 */6 * * *
WORKFLOW_LOG_LEVEL=INFO
WORKFLOW_ENABLE_VERSION_VALIDATION=false

# Lineage Configuration
LINEAGE_INCLUDE_SOURCE=true
LINEAGE_INCLUDE_DESTINATION=true
LINEAGE_INCLUDE_CONNECTION=true
LINEAGE_INCLUDE_TABLE_LINEAGE=true
LINEAGE_INCLUDE_COLUMN_LINEAGE=true

# Metadata Configuration
METADATA_OWNER=data-team
METADATA_DOMAIN=sia

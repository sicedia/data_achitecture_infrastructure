name: DBT CI

on:
  push:
    branches: [ main ]
  pull_request:
    branches: [ main ]

jobs:
  dbt-test:
    runs-on: ubuntu-latest
    
    steps:
      - name: Checkout repository
        uses: actions/checkout@v2
        
      - name: Set up Python
        uses: actions/setup-python@v2
        with:
          python-version: '3.8'

      - name: Install dbt dependencies
        run: |
          python -m pip install --upgrade pip
          pip install dbt-core dbt-postgres

      - name: Run dbt debug
        run: dbt debug --profiles-dir ./dbt/profiles

      - name: Run dbt run
        run: dbt run --profiles-dir ./dbt/profiles

      - name: Run dbt test
        run: dbt test --profiles-dir ./dbt/profiles
